// ═══════════════════════════════════════════════════════════════════
// O.R.I.O.N · Prisma schema · Postgres
// Fonte: handoff seção 05 (schema do banco de dados)
// ═══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ───────────────────────────────────────────────────────────

enum OrionMode {
  SILENCIOSO
  NORMAL
  STARK
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum PreferenceLayer {
  current
  nostalgia
  exploration
}

enum TriggerType {
  cron
  temporal
  event
  behavioral
  contextual
  manual
}

enum AutomationStatus {
  success
  failed
  pending
  skipped
  pending_confirmation
  confirmed
  executed
  dismissed
}

enum AlertPriority {
  low
  medium
  high
  critical
}

enum MemoryType {
  fact
  preference
  event
  feedback
  project
  relationship
}

enum IntegrationProvider {
  gmail
  gcal
  gdrive
  notion
  slack
  spotify
  booking
}

enum IntegrationStatus {
  connected
  expired
  revoked
  error
}

enum ChatRole {
  user
  assistant
  system
  tool
}

enum TaskStatus {
  todo
  doing
  done
  archived
}

// ── USUÁRIOS ────────────────────────────────────────────────────────

model User {
  id          String     @id @default(cuid())
  clerkId     String     @unique
  name        String
  email       String     @unique
  avatar      String?
  avatarColor String     @default("#00D4FF")
  plan        Plan       @default(FREE)
  mode        OrionMode  @default(NORMAL)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  profile         UserProfile?
  preferences     UserPreference[]
  projects        Project[]
  modules         UserModule[]
  integrations    Integration[]
  automations     Automation[]
  memories        Memory[]
  conversations   Conversation[]
  alerts          ProactiveAlert[]
  subscription    Subscription?
  tasks           Task[]
  lessons         LessonSession[]
  patterns        UserPattern[]
  documentAnalyses DocumentAnalysis[]
  energyLogs      EnergyLog[]
  focusSessions   FocusSession[]
  habits          Habit[]
  sleepLogs       SleepLog[]
  healthSyncSources HealthSyncSource[]
  contentIdeas    ContentIdea[]
  gameEntries     GameEntry[]
}

model UserProfile {
  userId      String   @id
  bio         String   @default("")
  timezone    String   @default("America/Sao_Paulo")
  language    String   @default("pt-BR")
  themePrimary   String @default("#00D4FF")
  themeSecondary String @default("#7C3AED")
  themeAccent    String @default("#F59E0B")
  onboardedAt DateTime?
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id         String          @id @default(cuid())
  userId     String
  key        String
  value      String
  layer      PreferenceLayer @default(current)
  confidence Float           @default(0.5)
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, layer])
  @@index([userId])
}

// ── PROJETOS ────────────────────────────────────────────────────────

model Project {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#00D4FF")
  progress  Int      @default(0)
  status    String   @default("conceito")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── MÓDULOS ─────────────────────────────────────────────────────────

model UserModule {
  userId    String
  moduleId  String
  enabled   Boolean  @default(false)
  config    Json     @default("{}")
  lastUsed  DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, moduleId])
  @@index([userId])
}

// ── INTEGRAÇÕES ─────────────────────────────────────────────────────

model Integration {
  id           String              @id @default(cuid())
  userId       String
  provider     IntegrationProvider
  accessToken  String              @db.Text
  refreshToken String?             @db.Text
  expiresAt    DateTime?
  scopes       String[]
  mcpUrl       String
  status       IntegrationStatus   @default(connected)
  connectedAt  DateTime            @default(now())
  lastUsedAt   DateTime?
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// ── AUTOMAÇÕES ──────────────────────────────────────────────────────

model Automation {
  id                   String          @id @default(cuid())
  userId               String
  name                 String
  description          String?
  triggerType          TriggerType
  triggerConfig        Json            @default("{}")
  conditions           Json?
  actions              Json            @default("[]")
  requiresConfirmation Boolean         @default(false)
  confirmationTimeout  Int             @default(240)
  enabled              Boolean         @default(true)
  lastTriggered        DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs                 AutomationLog[]

  @@index([userId])
  @@index([enabled, triggerType])
}

model AutomationLog {
  id           String           @id @default(cuid())
  automationId String
  triggeredAt  DateTime         @default(now())
  status       AutomationStatus
  result       Json             @default("{}")
  userResponse String?
  executionMs  Int?
  automation   Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

// ── MEMÓRIA ─────────────────────────────────────────────────────────

model Memory {
  id         String     @id @default(cuid())
  userId     String
  type       MemoryType
  content    String     @db.Text
  embedding  Float[]
  importance Float      @default(0.5)
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
}

// ── CONVERSAS ───────────────────────────────────────────────────────

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  moduleId  String?
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String       @db.Text
  toolCalls      Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ── ALERTAS PROATIVOS ───────────────────────────────────────────────

model ProactiveAlert {
  id        String        @id @default(cuid())
  userId    String
  module    String
  icon      String        @default("◈")
  color     String        @default("#00D4FF")
  title     String
  text      String        @db.Text
  action    String        @db.Text
  priority  AlertPriority @default(medium)
  dismissed Boolean       @default(false)
  approved  Boolean       @default(false)
  createdAt DateTime      @default(now())
  expiresAt DateTime?
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dismissed])
  @@index([userId, approved])
}

// ── LESSONS (Módulo Conhecimento) ───────────────────────────────────

model LessonSession {
  id          String          @id @default(cuid())
  userId      String
  topic       String
  level       String          @default("intermediario") // iniciante | intermediario | avancado
  // material estruturado gerado: { objetivos, topicos, exemplos, exercicios, proximos_passos }
  material    Json
  // tags pra busca rápida ("inglês", "react", "tarot", "química")
  tags        String[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    LessonMessage[]

  @@index([userId, createdAt])
}

model LessonMessage {
  id        String        @id @default(cuid())
  sessionId String
  role      ChatRole
  content   String        @db.Text
  createdAt DateTime      @default(now())
  session   LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// ── DOCS (Google Drive + Uploads) ───────────────────────────────────

model DocumentAnalysis {
  id        String   @id @default(cuid())
  userId    String
  fileName  String
  mimeType  String
  source    String
  fileId    String?
  summary   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, source])
}

// ── TASKS (Life OS) ─────────────────────────────────────────────────

model Task {
  id           String     @id @default(cuid())
  userId       String
  title        String
  notes        String?    @db.Text
  status       TaskStatus @default(todo)
  // 1=low energy, 2=normal, 3=high energy required
  energy       Int        @default(2)
  // 1=low, 2=normal, 3=high
  priority     Int        @default(2)
  scheduledFor DateTime?
  dueAt        DateTime?
  estMinutes   Int?
  projectId    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, scheduledFor])
}

// ── HEALTH ──────────────────────────────────────────────────────────

model EnergyLog {
  id        String   @id @default(cuid())
  userId    String
  value     Int
  note      String?  @db.Text
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, value])
}

model FocusSession {
  id            String    @id @default(cuid())
  userId        String
  duration      Int
  breakMinutes  Int       @default(5)
  completed     Boolean   @default(false)
  interruptedAt DateTime?
  endedAt       DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, completed])
}

model Habit {
  id         String     @id @default(cuid())
  userId     String
  name       String
  frequency  String
  color      String     @default("#00D4FF")
  icon       String     @default("✓")
  streak     Int        @default(0)
  bestStreak Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs       HabitLog[]

  @@index([userId])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  date      DateTime
  completed Boolean  @default(true)
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId, date])
}

model SleepLog {
  id        String   @id @default(cuid())
  userId    String
  bedTime   DateTime
  wakeTime  DateTime
  quality   Int      @default(3)
  notes     String?  @db.Text
  source    String   @default("manual")
  externalId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, bedTime])
  @@index([userId, wakeTime])
  @@index([userId, source, externalId])
}

model HealthSyncSource {
  id           String   @id @default(cuid())
  userId       String
  provider     String
  status       String   @default("ready")
  deviceName   String?
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model ContentIdea {
  id          String    @id @default(cuid())
  userId      String
  title       String
  body        String    @db.Text
  niche       String
  format      String
  status      String    @default("idea")
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, scheduledAt])
}

model GameEntry {
  id          String   @id @default(cuid())
  userId      String
  title       String
  platform    String
  status      String   @default("want")
  genre       String?
  hoursPlayed Float    @default(0)
  rating      Int?
  dealActive  Boolean  @default(false)
  dealPrice   Float?
  coverUrl    String?
  rawgId      Int?
  addedAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, title])
  @@index([userId, rawgId])
}

// ── USER PATTERNS (Memória mid-term) ────────────────────────────────

model UserPattern {
  id          String   @id @default(cuid())
  userId      String
  patternType String   // 'energy_peak' | 'module_usage' | 'response_time' | 'topic_frequency'
  data        Json
  confidence  Float    @default(0.5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, patternType])
  @@index([userId])
}

// ── BILLING ─────────────────────────────────────────────────────────

model Subscription {
  userId      String    @id
  plan        Plan
  status      String
  stripeId    String?   @unique
  periodEnd   DateTime?
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
