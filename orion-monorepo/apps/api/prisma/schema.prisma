// ═══════════════════════════════════════════════════════════════════
// O.R.I.O.N · Prisma schema · Postgres
// Fonte: handoff seção 05 (schema do banco de dados)
// ═══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ───────────────────────────────────────────────────────────

enum OrionMode {
  SILENCIOSO
  NORMAL
  STARK
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum PreferenceLayer {
  current
  nostalgia
  exploration
}

enum TriggerType {
  temporal
  event
  behavioral
  contextual
  manual
}

enum AutomationStatus {
  success
  failed
  pending
  skipped
}

enum AlertPriority {
  low
  medium
  high
  critical
}

enum MemoryType {
  fact
  preference
  event
  feedback
}

enum IntegrationProvider {
  gmail
  gcal
  gdrive
  notion
  slack
  spotify
  booking
}

enum IntegrationStatus {
  connected
  expired
  revoked
  error
}

enum ChatRole {
  user
  assistant
  system
  tool
}

enum TaskStatus {
  todo
  doing
  done
  archived
}

// ── USUÁRIOS ────────────────────────────────────────────────────────

model User {
  id          String     @id @default(cuid())
  clerkId     String     @unique
  name        String
  email       String     @unique
  avatar      String?
  avatarColor String     @default("#00D4FF")
  plan        Plan       @default(FREE)
  mode        OrionMode  @default(NORMAL)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  profile         UserProfile?
  preferences     UserPreference[]
  projects        Project[]
  modules         UserModule[]
  integrations    Integration[]
  automations     Automation[]
  memories        Memory[]
  conversations   Conversation[]
  alerts          ProactiveAlert[]
  subscription    Subscription?
  tasks           Task[]
  lessons         LessonSession[]
  patterns        UserPattern[]
}

model UserProfile {
  userId      String   @id
  bio         String   @default("")
  timezone    String   @default("America/Sao_Paulo")
  language    String   @default("pt-BR")
  themePrimary   String @default("#00D4FF")
  themeSecondary String @default("#7C3AED")
  themeAccent    String @default("#F59E0B")
  onboardedAt DateTime?
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id         String          @id @default(cuid())
  userId     String
  key        String
  value      String
  layer      PreferenceLayer @default(current)
  confidence Float           @default(0.5)
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, layer])
  @@index([userId])
}

// ── PROJETOS ────────────────────────────────────────────────────────

model Project {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#00D4FF")
  progress  Int      @default(0)
  status    String   @default("conceito")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── MÓDULOS ─────────────────────────────────────────────────────────

model UserModule {
  userId    String
  moduleId  String
  enabled   Boolean  @default(false)
  config    Json     @default("{}")
  lastUsed  DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, moduleId])
  @@index([userId])
}

// ── INTEGRAÇÕES ─────────────────────────────────────────────────────

model Integration {
  id           String              @id @default(cuid())
  userId       String
  provider     IntegrationProvider
  accessToken  String              @db.Text
  refreshToken String?             @db.Text
  expiresAt    DateTime?
  scopes       String[]
  mcpUrl       String
  status       IntegrationStatus   @default(connected)
  connectedAt  DateTime            @default(now())
  lastUsedAt   DateTime?
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// ── AUTOMAÇÕES ──────────────────────────────────────────────────────

model Automation {
  id            String          @id @default(cuid())
  userId        String
  name          String
  triggerType   TriggerType
  triggerConfig Json            @default("{}")
  actions       Json            @default("[]")
  enabled       Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs          AutomationLog[]

  @@index([userId])
}

model AutomationLog {
  id           String           @id @default(cuid())
  automationId String
  triggeredAt  DateTime         @default(now())
  status       AutomationStatus
  result       Json             @default("{}")
  automation   Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId])
}

// ── MEMÓRIA ─────────────────────────────────────────────────────────

model Memory {
  id         String     @id @default(cuid())
  userId     String
  type       MemoryType
  content    String     @db.Text
  embedding  Float[]
  importance Float      @default(0.5)
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
}

// ── CONVERSAS ───────────────────────────────────────────────────────

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  moduleId  String?
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String       @db.Text
  toolCalls      Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// ── ALERTAS PROATIVOS ───────────────────────────────────────────────

model ProactiveAlert {
  id        String        @id @default(cuid())
  userId    String
  module    String
  icon      String        @default("◈")
  color     String        @default("#00D4FF")
  title     String
  text      String        @db.Text
  action    String        @db.Text
  priority  AlertPriority @default(medium)
  dismissed Boolean       @default(false)
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dismissed])
}

// ── LESSONS (Módulo Conhecimento) ───────────────────────────────────

model LessonSession {
  id          String          @id @default(cuid())
  userId      String
  topic       String
  level       String          @default("intermediario") // iniciante | intermediario | avancado
  // material estruturado gerado: { objetivos, topicos, exemplos, exercicios, proximos_passos }
  material    Json
  // tags pra busca rápida ("inglês", "react", "tarot", "química")
  tags        String[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    LessonMessage[]

  @@index([userId, createdAt])
}

model LessonMessage {
  id        String        @id @default(cuid())
  sessionId String
  role      ChatRole
  content   String        @db.Text
  createdAt DateTime      @default(now())
  session   LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

// ── TASKS (Life OS) ─────────────────────────────────────────────────

model Task {
  id           String     @id @default(cuid())
  userId       String
  title        String
  notes        String?    @db.Text
  status       TaskStatus @default(todo)
  // 1=low energy, 2=normal, 3=high energy required
  energy       Int        @default(2)
  // 1=low, 2=normal, 3=high
  priority     Int        @default(2)
  scheduledFor DateTime?
  dueAt        DateTime?
  estMinutes   Int?
  projectId    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, scheduledFor])
}

// ── USER PATTERNS (Memória mid-term) ────────────────────────────────

model UserPattern {
  id          String   @id @default(cuid())
  userId      String
  patternType String   // 'energy_peak' | 'module_usage' | 'response_time' | 'topic_frequency'
  data        Json
  confidence  Float    @default(0.5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, patternType])
  @@index([userId])
}

// ── BILLING ─────────────────────────────────────────────────────────

model Subscription {
  userId      String    @id
  plan        Plan
  status      String
  stripeId    String?   @unique
  periodEnd   DateTime?
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
