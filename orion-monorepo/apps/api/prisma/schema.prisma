// ═══════════════════════════════════════════════════════════════════
// O.R.I.O.N · Prisma schema · Postgres
// ═══════════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ───────────────────────────────────────────────────────────

enum OrionMode {
  SILENCIOSO
  NORMAL
  STARK
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

enum PreferenceLayer {
  current
  nostalgia
  exploration
}

enum TriggerType {
  cron
  temporal
  event
  behavioral
  contextual
  manual
}

enum AutomationStatus {
  success
  failed
  pending
  skipped
  pending_confirmation
  confirmed
  executed
  dismissed
}

enum AlertPriority {
  low
  medium
  high
  critical
}

enum MemoryType {
  fact
  preference
  event
  feedback
  project
  relationship
}

enum IntegrationProvider {
  gmail
  gcal
  gdrive
  notion
  slack
  spotify
  booking
}

enum IntegrationStatus {
  connected
  expired
  revoked
  error
}

enum ChatRole {
  user
  assistant
  system
  tool
}

enum TaskStatus {
  todo
  doing
  done
  archived
}

enum IdeaStatus {
  ideia
  rascunho
  agendado
  publicado
  arquivado
}

enum GameStatus {
  wishlist
  playing
  finished
  dropped
  paused
}

// ── USUÁRIOS ────────────────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  clerkId     String    @unique
  name        String
  email       String    @unique
  avatar      String?
  avatarColor String    @default("#00D4FF")
  plan        Plan      @default(FREE)
  mode        OrionMode @default(NORMAL)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  profile       UserProfile?
  preferences   UserPreference[]
  projects      Project[]
  modules       UserModule[]
  integrations  Integration[]
  automations   Automation[]
  memories      Memory[]
  conversations Conversation[]
  alerts        ProactiveAlert[]
  subscription  Subscription?
  tasks         Task[]
  lessons       LessonSession[]
  patterns      UserPattern[]
  energyLogs    EnergyLog[]
  focusSessions FocusSession[]
  habits        Habit[]
  contentIdeas  ContentIdea[]
  games         GameEntry[]
  newsItems     NewsItem[]
  sleepLogs     SleepLog[]
  wishlist      WishlistItem[]
}

model UserProfile {
  userId         String    @id
  bio            String    @default("")
  timezone       String    @default("America/Sao_Paulo")
  language       String    @default("pt-BR")
  themePrimary   String    @default("#00D4FF")
  themeSecondary String    @default("#7C3AED")
  themeAccent    String    @default("#F59E0B")
  onboardedAt    DateTime?
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPreference {
  id         String          @id @default(cuid())
  userId     String
  key        String
  value      String
  layer      PreferenceLayer @default(current)
  confidence Float           @default(0.5)
  updatedAt  DateTime        @updatedAt
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key, layer])
  @@index([userId])
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#00D4FF")
  progress  Int      @default(0)
  status    String   @default("conceito")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserModule {
  userId    String
  moduleId  String
  enabled   Boolean   @default(false)
  config    Json      @default("{}")
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, moduleId])
  @@index([userId])
}

model Integration {
  id           String              @id @default(cuid())
  userId       String
  provider     IntegrationProvider
  accessToken  String              @db.Text
  refreshToken String?             @db.Text
  expiresAt    DateTime?
  scopes       String[]
  mcpUrl       String
  status       IntegrationStatus   @default(connected)
  connectedAt  DateTime            @default(now())
  lastUsedAt   DateTime?
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

model Automation {
  id                   String          @id @default(cuid())
  userId               String
  name                 String
  description          String?         @db.Text
  triggerType          TriggerType
  triggerConfig        Json            @default("{}")
  conditions           Json?
  actions              Json            @default("[]")
  requiresConfirmation Boolean         @default(false)
  confirmationTimeout  Int             @default(240)
  enabled              Boolean         @default(true)
  lastTriggered        DateTime?
  templateKey          String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs                 AutomationLog[]

  @@index([userId])
  @@index([userId, enabled])
}

model AutomationLog {
  id           String           @id @default(cuid())
  automationId String
  triggeredAt  DateTime         @default(now())
  status       AutomationStatus
  result       Json             @default("{}")
  userResponse String?
  executionMs  Int?
  automation   Automation       @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, triggeredAt])
}

model Memory {
  id         String     @id @default(cuid())
  userId     String
  type       MemoryType
  content    String     @db.Text
  embedding  Float[]
  importance Float      @default(0.5)
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  moduleId  String?
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           ChatRole
  content        String       @db.Text
  toolCalls      Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model ProactiveAlert {
  id        String        @id @default(cuid())
  userId    String
  module    String
  icon      String        @default("◈")
  color     String        @default("#00D4FF")
  title     String
  text      String        @db.Text
  action    String        @db.Text
  priority  AlertPriority @default(medium)
  dismissed Boolean       @default(false)
  approved  Boolean       @default(false)
  dedupKey  String?
  expiresAt DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupKey])
  @@index([userId, dismissed, priority])
  @@index([userId, expiresAt])
}

model LessonSession {
  id        String          @id @default(cuid())
  userId    String
  topic     String
  level     String          @default("intermediario")
  material  Json
  tags      String[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  LessonMessage[]

  @@index([userId, createdAt])
}

model LessonMessage {
  id        String        @id @default(cuid())
  sessionId String
  role      ChatRole
  content   String        @db.Text
  createdAt DateTime      @default(now())
  session   LessonSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model Task {
  id           String     @id @default(cuid())
  userId       String
  title        String
  notes        String?    @db.Text
  status       TaskStatus @default(todo)
  energy       Int        @default(2)
  priority     Int        @default(2)
  scheduledFor DateTime?
  dueAt        DateTime?
  estMinutes   Int?
  projectId    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, scheduledFor])
}

model EnergyLog {
  id        String   @id @default(cuid())
  userId    String
  value     Int
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model FocusSession {
  id            String    @id @default(cuid())
  userId        String
  duration      Int       @default(25)
  actualMinutes Int?
  completed     Boolean   @default(false)
  interruptedAt DateTime?
  note          String?
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

model Habit {
  id         String     @id @default(cuid())
  userId     String
  name       String
  frequency  String     @default("daily")
  color      String     @default("#00D4FF")
  icon       String     @default("✓")
  streak     Int        @default(0)
  bestStreak Int        @default(0)
  archivedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs       HabitLog[]

  @@index([userId, archivedAt])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  date      String
  note      String?
  createdAt DateTime @default(now())
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([habitId, date])
}

model ContentIdea {
  id          String     @id @default(cuid())
  userId      String
  title       String
  body        String?    @db.Text
  niche       String     @default("geral")
  format      String     @default("reels")
  status      IdeaStatus @default(ideia)
  scheduledAt DateTime?
  publishedAt DateTime?
  tags        String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model GameEntry {
  id          String     @id @default(cuid())
  userId      String
  title       String
  rawgId      Int?
  platform    String?
  genre       String?
  status      GameStatus @default(wishlist)
  hoursPlayed Float      @default(0)
  rating      Int?
  notes       String?    @db.Text
  coverUrl    String?
  releasedAt  String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model NewsItem {
  id        String   @id @default(cuid())
  userId    String
  title     String
  summary   String?  @db.Text
  url       String
  source    String?
  category  String   @default("geral")
  read      Boolean  @default(false)
  saved     Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, url])
  @@index([userId, read, createdAt])
}

model SleepLog {
  id        String   @id @default(cuid())
  userId    String
  bedTime   DateTime
  wakeTime  DateTime
  quality   Int      @default(3)
  notes     String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, bedTime])
}

model WishlistItem {
  id           String   @id @default(cuid())
  userId       String
  name         String
  url          String
  targetPrice  Float?
  currentPrice Float?
  priceHistory Json     @default("[]")
  alertAtPct   Int      @default(20)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserPattern {
  id          String   @id @default(cuid())
  userId      String
  patternType String
  data        Json
  confidence  Float    @default(0.5)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, patternType])
  @@index([userId])
}

model Subscription {
  userId    String    @id
  plan      Plan
  status    String
  stripeId  String?   @unique
  periodEnd DateTime?
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
