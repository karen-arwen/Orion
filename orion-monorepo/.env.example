# ═══════════════════════════════════════════════════════════════════
# O.R.I.O.N — Environment template (copy to .env on each app folder)
# ═══════════════════════════════════════════════════════════════════

# ── BACKEND (apps/api/.env) ──────────────────────────────────────
DATABASE_URL="postgresql://orion:orion_dev@localhost:5432/orion?schema=public"
REDIS_URL="redis://localhost:6379"

# Anthropic (Claude núcleo)
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-4-6"

# Clerk (OAuth Google)
CLERK_SECRET_KEY="sk_test_..."
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_WEBHOOK_SECRET="whsec_..."

# Google APIs (caso queira ir além do MCP)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (billing)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Servidor
PORT=3001
NODE_ENV="development"
WEB_ORIGIN="http://localhost:5173"
JWT_SECRET="change-me-in-prod"

# Future connectors / dev local
GITHUB_TOKEN=
NOTION_TOKEN=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://127.0.0.1:3001/v1/integrations/notion/callback
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_VERIFICATION_TOKEN=
GITHUB_WEBHOOK_SECRET=
LINEAR_WEBHOOK_SECRET=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/v1/integrations/spotify/callback
TODOIST_API_TOKEN=
LINEAR_API_KEY=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_OAUTH_TOKEN=

# ── FRONTEND (apps/web/.env.local) ───────────────────────────────
VITE_API_URL="http://localhost:3001"
VITE_CLERK_PUBLISHABLE_KEY="pk_test_..."
VITE_STRIPE_PUBLIC_KEY="pk_test_..."
